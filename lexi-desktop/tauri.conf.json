{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lexi",
  "version": "0.3.0",
  "identifier": "com.lexi.desktop",
  "build": {
    "frontendDist": "./frontend"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Lexi",
        "width": 1000,
        "height": 760
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Multi-provider LLM chat over the Rust lexi-core engine.",
    "longDescription": "Lexi — a provider-agnostic desktop client for multiple LLM providers, a thin webview shell over the Rust lexi-host runtime and lexi-core engine. No Node, no Python, no server.",
    "copyright": "MIT"
  }
}
