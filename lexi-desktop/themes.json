      },
      "background": "radial-gradient(circle at 10% 20%, rgba(6, 182, 212, 0.2), transparent 35%), radial-gradient(circle at 90% 10%, rgba(34, 211, 238, 0.15), transparent 30%), #0a1628",
      "swatch": "linear-gradient(135deg, #06b6d4, #22d3ee)"
    },
    {
      "id": "dark-purple",
