{
  "name": "pinned-api-wins",
  "description": "A configured model's explicit `api:` beats tags.",
  "provider": {
    "apis": [
      {
        "api": "responses",
        "default_model": "gpt-4o"
      },
      {
        "api": "image-generations",
        "for": [
          "kind:image-generation"
        ],
        "default_model": "gpt-image-2.5-flare"
      }
    ],
    "tag_rules": {
      "gpt-image-*": [
        "kind:image-generation"
      ],
      "chatgpt-image-*": [
        "kind:image-generation"
      ],
      "text-embedding-*": [
        "kind:embedding"
      ],
      "gpt-*": [
        "feature:tools",
        "feature:web-search"
      ]
    }
  },
  "model": "gpt-4o",
  "pinned_api": "image-generations",
  "expect": {
    "model": "gpt-4o",
    "kind": "image-generation",
    "api": "image-generations",
    "binding": 1,
    "tags": [
      {
        "tag": "in:text",
        "source": "api:image-generations"
      },
      {
        "tag": "out:image",
        "source": "api:image-generations"
      },
      {
        "tag": "kind:image-generation",
        "source": "api:image-generations"
      },
      {
        "tag": "feature:tools",
        "source": "rule:gpt-*"
      },
      {
        "tag": "feature:web-search",
        "source": "rule:gpt-*"
      }
    ]
  }
}
