{
  "name": "messages-image-base64",
  "description": "A base64 image part lowers to Anthropic's structured base64 source.",
  "api": "messages",
  "compose": {
    "prompt_payload": { "model": "claude-sonnet-4-6" },
    "message": {
      "role": "user",
      "content": [
        { "type": "text", "text": "Describe this image." },
        { "type": "image", "data": "QUJD", "media_type": "image/png" }
      ]
    }
  },
  "expect_body": {
    "model": "claude-sonnet-4-6",
    "messages": [
      {
        "role": "user",
        "content": [
          { "type": "text", "text": "Describe this image." },
          { "type": "image", "source": { "type": "base64", "media_type": "image/png", "data": "QUJD" } }
        ]
      }
    ],
    "max_tokens": 4096
  }
}
