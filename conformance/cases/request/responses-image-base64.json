{
  "name": "responses-image-base64",
  "description": "A base64 image part lowers to a data: URI in Responses' input_image.",
  "api": "responses",
  "compose": {
    "prompt_payload": { "model": "gpt-4o" },
    "message": {
      "role": "user",
      "content": [
        { "type": "text", "text": "Describe this image." },
        { "type": "image", "data": "QUJD", "media_type": "image/png" }
      ]
    }
  },
  "expect_body": {
    "model": "gpt-4o",
    "input": [
      {
        "role": "user",
        "content": [
          { "type": "input_text", "text": "Describe this image." },
          { "type": "input_image", "image_url": "data:image/png;base64,QUJD" }
        ]
      }
    ],
    "store": true
  }
}
